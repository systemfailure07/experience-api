                <munit:attributes
                    value="#[{uriParams: {contactId: 'CT-1001'}}]"/>
            </munit:set-event>

            <flow-ref
                doc:name="Flow-ref to delete-contact-experience-flow"
                doc:id="76cbe3ba-a825-4f63-98c9-0466c4cc890d"
                name="delete-contact-experience-flow"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.success]"
                is="#[MunitTools::equalTo(true)]"
                message="Delete should return a successful response"/>
        </munit:validation>

    </munit:test>

</mule>