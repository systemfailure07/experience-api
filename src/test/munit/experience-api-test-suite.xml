                    mediaType="application/java"/>
                <munit:attributes
                    value="#[{uriParams: {contactId: 'CT-1001'}}]"/>
            </munit:set-event>

            <flow-ref
                doc:name="Flow-ref to update-contact-experience-flow"
                doc:id="f373c50d-aade-4e06-a2af-092376caf349"
                name="update-contact-experience-flow"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.lastName]"
                is="#[MunitTools::equalTo('Smith')]"
                message="Update should return the updated contact"/>
            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo(200)]"
                message="Update should return HTTP 200"/>
        </munit:validation>

    </munit:test>


    <!-- 4. DELETE CONTACT -->

    <munit:test
        name="experience-api-test-suite-delete-contact-experience-flowTest"
        doc:id="b6e24689-b825-46ba-b322-88b60aa89547"
        description="Test delete contact experience flow">

        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="method"
                        whereValue="#['DELETE']"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[{success: true, contactId: 'CT-1001'}]"
                        mediaType="application/java"/>
                    <munit-tools:attributes
                        value="#[{statusCode: 200, reasonPhrase: 'OK', headers: {}}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:payload
                    value="#[{}]"
